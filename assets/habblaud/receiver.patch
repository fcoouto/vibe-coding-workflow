@@ -617,6 +617,32 @@ export class Office {
     return true;
   }

+  setSubRole(id: string, parentId: string, role: string): void {
+    const info = this.agents.get(id)?.info;
+    if (!info || info.kind !== 'sub' || info.parentId !== parentId || info.role === role) return;
+    info.role = role;
+    this.markDirty();
+  }
+
+  reparentSub(id: string, parentId: string): boolean {
+    const info = this.agents.get(id)?.info;
+    const parent = this.agents.get(parentId)?.info;
+    if (!info || info.kind !== 'sub' || !parent || info.account !== parent.account
+        || info.provider !== parent.provider || info.roomId !== parent.roomId) return false;
+    const seen = new Set([id]);
+    let ancestor: AgentInfo | undefined = parent;
+    while (ancestor) {
+      if (seen.has(ancestor.id)) return false;
+      seen.add(ancestor.id);
+      ancestor = ancestor.parentId ? this.agents.get(ancestor.parentId)?.info : undefined;
+    }
+    if (info.parentId !== parentId) {
+      info.parentId = parentId;
+      this.markDirty();
+    }
+    return true;
+  }
+
   completeSub(id: string, opts: { notify?: boolean } = {}): void {
     const rec = this.agents.get(id);
     if (!rec || rec.info.kind !== 'sub' || rec.info.status === 'done' || rec.info.status === 'offline') return;
