index 0000000..6dd95b2
--- /dev/null
+++ b/server/sources/codex/badges.ts
@@ -0,0 +1,73 @@
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { isUnreportedCodexRole } from '../../../shared/codex-role';
+import { tr } from '../../../shared/i18n';
+import { errMsg, log } from '../../log';
+import { readRolloutHead } from './files';
+
+export function declaredDisplayLabel(raw: unknown): string | undefined {
+  const maxCodePoints = 8_195;
+  if (typeof raw !== 'string' || raw.length > 2 * maxCodePoints || [...raw].length > maxCodePoints
+    || raw.trim() !== raw || /[\p{C}\p{Zl}\p{Zp}]/u.test(raw) || /guardian/i.test(raw)) return undefined;
+  const separator = raw.lastIndexOf(' · ');
+  return separator > 0 && raw.slice(separator + 3).trim() ? raw : undefined;
+}
+
+// Mesmo limite de nomes persistidos dos personagens.
+const MAX_BADGES = 4_000;
+
+/** Guarda apenas a apresentação, vinculada à pasta da conta e à relação pai/filho. */
+export class CodexBadges {
+  private readonly labels = new Map<string, string>();
+  private dirty = false;
+
+  constructor(private readonly file?: string) {
+    if (!file) return;
+    try {
+      const saved = JSON.parse(readFileSync(file, 'utf8'));
+      if (saved?.version !== 1 || !saved.labels || typeof saved.labels !== 'object' || Array.isArray(saved.labels)) return;
+      for (const [key, raw] of Object.entries(saved.labels).slice(-MAX_BADGES)) {
+        const label = declaredDisplayLabel(raw);
+        if (label && !isUnreportedCodexRole(label)) this.labels.set(key, label);
+      }
+    } catch {
+      // Um arquivo indisponível não muda a presença nem a execução dos agentes.
+    }
+  }
+
+  get(accountDir: string, child: string, parent: string): string | undefined {
+    return this.labels.get(JSON.stringify([accountDir, child, parent]));
+  }
+
+  remember(accountDir: string, child: string, parent: string, label: string): string {
+    const key = JSON.stringify([accountDir, child, parent]);
+    const saved = this.labels.get(key);
+    if (saved === undefined) {
+      this.labels.set(key, label);
+      if (this.labels.size > MAX_BADGES) this.labels.delete(this.labels.keys().next().value!);
+      this.dirty = true;
+    }
+    this.save();
+    return saved ?? label;
+  }
+
+  rememberNative(accountDir: string, child: string, parent: string, label: string, path?: string): boolean {
+    const meta = path && readRolloutHead(path).meta;
+    if (!meta || meta.internal || meta.threadId !== child || meta.parentThreadId !== parent) return false;
+    return this.remember(accountDir, child, parent, label) === label && (!this.file || !this.dirty);
+  }
+
+  private save(): void {
+    if (!this.file || !this.dirty) return;
+    try {
+      mkdirSync(dirname(this.file), { recursive: true });
+      const tmp = `${this.file}.${process.pid}.tmp`;
+      writeFileSync(tmp, JSON.stringify({ version: 1, labels: Object.fromEntries(this.labels) }), { mode: 0o600 });
+      renameSync(tmp, this.file);
+      this.dirty = false;
+      log.clearOnce('codex-badges-write');
+    } catch (err) {
+      log.warnOnce('codex-badges-write', tr('Não consegui gravar {0}: {1}', [this.file, errMsg(err)]));
+    }
+  }
+}
