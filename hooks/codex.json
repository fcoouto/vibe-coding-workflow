{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/scripts/workflow.py\" codex SessionStart",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
